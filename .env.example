# NAZMan development environment configuration.
# Copy to .env and adjust for running the dev server without touching /etc/nazman.
# NOTE: pydantic-settings reads /etc/nazman/nazman.conf by default; to override
# for local development, uncomment the lines below. The test suite ignores these
# and uses temp dirs.

# Database
DATABASE_PATH = ./dev/nazman.db

# Backup
BACKUP_ENABLED = false
BACKUP_REPO_PATH = ./dev/backup-repo

# Auth (disable for local development)
AUTH_ENABLED = false
AUTH_PASSWORD_HASH =

# Monitoring
MONITORING_REFRESH_INTERVAL = 5
MONITORING_ENABLE_WEBSOCKET = true

# Logging
LOGGING_LEVEL = DEBUG
LOGGING_FILE = ./dev/nazman.log

# App
APP_HOST = 0.0.0.0
APP_PORT = 8080
